#!/usr/bin/make -f
#
# XWorkmate ships to Launchpad as a prebuilt payload: distribution build
# chroots have neither the Flutter SDK nor network access, so the source
# package carries the compiled bundle as payload.tar.gz and this file only
# unpacks it. It is an archive rather than a loose tree because dpkg-source's
# default tar-ignore patterns (*.so, *.a, *.o) would drop most of a Flutter
# bundle. Regenerate it with scripts/package-linux-payload.sh.

PAYLOAD_ARCHIVE := payload.tar.gz

%:
	dh $@

override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:
override_dh_auto_clean:

override_dh_auto_install:
	@if [ ! -f "$(PAYLOAD_ARCHIVE)" ]; then \
		echo "ERROR: $(PAYLOAD_ARCHIVE) is missing." >&2; \
		echo "       Run scripts/package-linux-payload.sh before building this source package." >&2; \
		exit 1; \
	fi
	mkdir -p debian/xworkmate
	tar -xzf $(PAYLOAD_ARCHIVE) -C debian/xworkmate
	@test -x debian/xworkmate/opt/xworkmate/xworkmate \
		|| { echo "ERROR: $(PAYLOAD_ARCHIVE) does not carry opt/xworkmate/xworkmate." >&2; exit 1; }
	mkdir -p debian/xworkmate/usr/bin
	ln -sf /opt/xworkmate/xworkmate debian/xworkmate/usr/bin/xworkmate

# The payload is a self-contained Flutter bundle with its own private
# libraries; letting debhelper rewrite or introspect it would either strip the
# shipped binaries or emit dependencies on the bundled sonames themselves.
override_dh_shlibdeps:
override_dh_makeshlibs:
override_dh_strip:
override_dh_dwz:
override_dh_strip_nondeterminism:
