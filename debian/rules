#!/usr/bin/make -f
#
# XWorkmate ships to Launchpad as a prebuilt payload: distribution build
# chroots have neither the Flutter SDK nor network access, so the source
# package carries the compiled bundle under payload/ and this file only
# installs it. Regenerate the payload with scripts/package-linux-payload.sh.

PAYLOAD := payload

%:
	dh $@

override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:
override_dh_auto_clean:

override_dh_auto_install:
	@if [ ! -x "$(PAYLOAD)/opt/xworkmate/xworkmate" ]; then \
		echo "ERROR: $(PAYLOAD)/opt/xworkmate/xworkmate is missing." >&2; \
		echo "       Run scripts/package-linux-payload.sh before building this source package." >&2; \
		exit 1; \
	fi
	mkdir -p debian/xworkmate
	cp -a $(PAYLOAD)/. debian/xworkmate/
	mkdir -p debian/xworkmate/usr/bin
	ln -sf /opt/xworkmate/xworkmate debian/xworkmate/usr/bin/xworkmate

# The payload is a self-contained Flutter bundle with its own private
# libraries; letting debhelper rewrite or introspect it would either strip the
# shipped binaries or emit dependencies on the bundled sonames themselves.
override_dh_shlibdeps:
override_dh_makeshlibs:
override_dh_strip:
override_dh_dwz:
override_dh_strip_nondeterminism:
